<script setup lang="ts">
import { ref, watch } from 'vue'

const props = defineProps<{
  show: boolean
  clientName: string
}>()

const emit = defineEmits<{
  (e: 'close'): void
  (e: 'confirm', reason: string): void
}>()

const reason = ref('')

watch(
  () => props.show,
  (newVal) => {
    if (newVal) {
      reason.value = ''
    }
  },
)

const handleConfirm = () => {
  if (reason.value.trim()) {
    emit('confirm', reason.value.trim())
