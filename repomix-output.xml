    const rawMail = Buffer.from(mailParts.join('\r\n'))
      .toString('base64')
      .replace(/\+/g, '-')
      .replace(/\//g, '_')
      .replace(/=+$/, '')

    await gmail.users.messages.send({
      userId: 'me',
      requestBody: { raw: rawMail },
    })
    logger.info(`[ESPÍA/sendMail] ¡ÉXITO! Correo único enviado.`)
