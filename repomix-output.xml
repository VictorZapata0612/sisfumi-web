}

const formatDate = (timestamp: any) => {
  if (!timestamp?.toDate) return 'Fecha inválida'
  return timestamp.toDate().toLocaleString('es-CO', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  })
}
