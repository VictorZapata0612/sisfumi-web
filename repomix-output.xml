      annualReportData.value = result.data
    } catch (err: any) {
      console.error('Error fetching annual report:', err)
      error.value = `No se pudo generar el reporte: ${err.message}`
    } finally {
      loading.value = false
    }
  }

  return {
    loading,
    error,
    annualReportData,
    fetchAnnualBillingReport,
  }
})
