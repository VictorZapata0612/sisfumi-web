        <div class="bg-[#151515] rounded-xl border border-white/10 shadow-lg overflow-hidden">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-white/5">
              <thead class="bg-[#0a0a0a]/50">
